<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">弹窗拦截</string>
    <string name="app_subtitle">自动识别并关闭浏览器里的垃圾弹窗</string>

    <!-- 服务状态 -->
    <string name="section_service">无障碍服务</string>
    <string name="service_on">已开启 · 正在保护中</string>
    <string name="service_off">未开启 · 拦截不会生效</string>
    <string name="service_tip">拦截完全依赖无障碍服务读取窗口内容。请在系统设置里找到「弹窗拦截」并打开开关。</string>
    <string name="enable_accessibility">去开启无障碍服务</string>
    <string name="open_accessibility_settings">查看无障碍设置</string>
    <string name="open_settings_failed">无法打开系统设置，请手动前往「设置 - 无障碍」</string>

    <!-- 拦截开关 -->
    <string name="section_switch">拦截设置</string>
    <string name="switch_enabled">拦截总开关</string>
    <string name="switch_enabled_desc">关闭后所有规则立即停用</string>
    <string name="switch_protect_all">保护所有应用</string>
    <string name="switch_protect_all_desc">默认只保护浏览器，开启后所有应用里的弹窗都会处理</string>
    <string name="switch_click_close">自动点击关闭按钮</string>
    <string name="switch_click_close_desc">识别到「关闭 / 跳过 / X」等按钮时自动点击</string>
    <string name="switch_back_fallback">返回键兜底</string>
    <string name="switch_back_fallback_desc">弹窗里找不到关闭按钮，但广告特征明显时，模拟返回键退出</string>
    <string name="switch_aggressive">激进模式</string>
    <string name="switch_aggressive_desc">把角落里没有文字的小图标也当成关闭按钮，命中率更高，但误判风险略增</string>

    <!-- 延迟 -->
    <string name="section_delay">识别延迟</string>
    <string name="delay_desc">检测到窗口变化后，等待这段时间再动手，避免页面还没渲染完就误点</string>
    <string name="delay_value">当前：%1$d 毫秒</string>

    <!-- 浏览器 -->
    <string name="section_browsers">受保护的浏览器</string>
    <string name="browser_hint">检测到 %1$d 个可打开网页的应用，默认全部保护</string>
    <string name="browser_empty">没有检测到浏览器</string>
    <string name="browser_protect_all_hint">已开启「保护所有应用」，下面的列表暂不生效</string>

    <!-- 拦截记录 -->
    <string name="section_logs">拦截记录</string>
    <string name="count_value">累计拦截 %1$d 次</string>
    <string name="clear_logs">清空记录</string>
    <string name="empty_logs">还没有拦截记录。去浏览器里逛一逛，被拦下来的弹窗会显示在这里。</string>

    <!-- 无障碍服务描述 -->
    <string name="accessibility_label">弹窗拦截</string>
    <string name="accessibility_summary">自动关闭浏览器中的垃圾弹窗</string>
    <string name="accessibility_desc">开启后，本服务会读取屏幕上的窗口内容，识别出广告弹窗并自动点击关闭或返回。只在本机处理，不会上传任何数据。</string>
</resources>

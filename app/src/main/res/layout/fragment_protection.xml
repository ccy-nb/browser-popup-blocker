<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <!-- 无障碍服务 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_service" />

                <TextView
                    android:id="@+id/tvServiceState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="已连接，正在保护中" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/service_tip"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnableService"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/enable_accessibility" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 总开关 + 策略 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swEnabled"
                    style="@style/Widget.App.SettingSwitch"
                    android:text="@string/sw_enabled"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Widget.App.SettingDesc"
                    android:text="@string/sw_enabled_desc" />

                <View
                    style="@style/Widget.App.Divider"
                    android:layout_marginTop="4dp" />

                <TextView
                    style="@style/TextAppearance.App.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/section_strategy" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swClickClose"
                    style="@style/Widget.App.SettingSwitch"
                    android:text="@string/sw_click_close" />

                <TextView
                    style="@style/Widget.App.SettingDesc"
                    android:text="@string/sw_click_close_desc" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swAggressive"
                    style="@style/Widget.App.SettingSwitch"
                    android:text="@string/sw_aggressive" />

                <TextView
                    style="@style/Widget.App.SettingDesc"
                    android:text="@string/sw_aggressive_desc" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 识别延迟 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/TextAppearance.App.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_delay" />

                    <TextView
                        android:id="@+id/tvDelayValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        tools:text="当前 800 毫秒" />
                </LinearLayout>

                <TextView
                    style="@style/Widget.App.SettingDesc"
                    android:layout_marginTop="6dp"
                    android:text="@string/delay_desc" />

                <SeekBar
                    android:id="@+id/seekDelay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
